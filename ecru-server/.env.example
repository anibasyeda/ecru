# Copy to .env and fill in. Never commit the real .env.
PORT=5000

# Local MongoDB: mongodb://127.0.0.1:27017/ecru
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/ecru
MONGO_URI=mongodb://127.0.0.1:27017/ecru

# Used to sign JWTs. Make it long and random in production.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma-separated. Vite dev server default below.
CLIENT_ORIGIN=http://localhost:5173
